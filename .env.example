# ============================================================
# Environment Variables — AI Autonomous Testing Agent
# ============================================================
# USAGE:
#   cp .env.example .env
#   # Edit .env with your actual values — NEVER commit .env
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=ai_testing_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# Full DSN used by SQLAlchemy / Alembic
DATABASE_URL=postgresql://postgres:change_me_in_production@postgres:5432/ai_testing_agent

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── AI Providers ─────────────────────────────────────────────
# Choose one: openai | gemini | anthropic
AI_PROVIDER=openai

OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI model to use (gpt-4o recommended for test generation)
OPENAI_MODEL=gpt-4o

# ── Application Security ─────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_random_64_char_string_minimum_32_chars_required

# JWT token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Frontend / CORS ──────────────────────────────────────────
# URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost/api

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost,http://localhost:3000

# ── ChromaDB (vector store) ──────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# ── Allure Reporting ─────────────────────────────────────────
ALLURE_RESULTS_DIR=/app/storage/reports/allure-results

# ── Playwright / Browser Automation ─────────────────────────
# headless: true for Docker; false for local debugging
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=0                  # ms delay between actions (debugging)
PLAYWRIGHT_TIMEOUT=30000              # ms default timeout

# ── File Storage Paths ───────────────────────────────────────
SCREENSHOTS_DIR=/app/storage/screenshots
VIDEOS_DIR=/app/storage/videos
LOGS_DIR=/app/storage/logs
REPORTS_DIR=/app/storage/reports

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR

# ── Environment ──────────────────────────────────────────────
ENVIRONMENT=development               # development | staging | production
DEBUG=false
